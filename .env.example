# Copy to .env for local development. Every key is optional:
# without them the site uses demo reviews and a simulated quote form.

# Production URL (used for canonical URLs, sitemap, JSON-LD)
SITE_URL=https://www.gigtechnology.pro

# Google reviews (Places API "New") - fetched at build time
GOOGLE_PLACES_API_KEY=
PLACE_ID=

# Quote form e-mails (https://resend.com)
RESEND_API_KEY=
# Inbox that receives quote requests (defaults to the email in src/data/site.json)
QUOTE_TO_EMAIL=
# Verified sender on Resend, e.g. "GIG Technology Website <quotes@yourdomain.com>"
QUOTE_FROM_EMAIL=
