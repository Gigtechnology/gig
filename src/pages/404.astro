---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
---

<BaseLayout title="Page not found | GIG Technology" description="This page does not exist." noindex>
  <section class="section">
    <div class="container nf">
      <span class="badge">Error 404</span>
      <h1>Page <span class="hl">not found</span></h1>
      <p>The page you are looking for doesn't exist or has moved.</p>
      <div class="btn-row">
        <a href="/" class="btn btn--primary btn--plain">Back to home</a>
        <a href={site.phone.href} class="btn btn--accent btn--plain"><Icon name="phone" size={18} /> {site.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    max-width: 640px;
  }
  .nf .btn-row {
    justify-content: center;
  }
</style>
