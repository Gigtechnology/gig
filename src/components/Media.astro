---
/**
 * Image slot. Shows the photo when `src` is set, otherwise a palette pattern
 * with the expected filename (listed in IMAGES-A-FOURNIR.md).
 */
interface Props {
  src?: string | null;
  file: string;
  alt: string;
  ratio?: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const { src, file, alt, ratio = '4 / 3', class: className = '', eager = false, sizes = '(max-width: 960px) 100vw, 50vw' } = Astro.props;
// Photos in /images/ have an 800 px "-800.jpg" variant (npm run images)
const srcset = src && /^\/images\/.+\.jpe?g$/i.test(src) ? `${src.replace(/\.jpe?g$/i, '-800.jpg')} 800w, ${src} 1600w` : undefined;
---

<div class:list={['media', className]} style={`aspect-ratio: ${ratio}`}>
  {
    src ? (
      <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <>
        {/* TODO : à confirmer avec le client — photo to provide */}
        <span class="media__label" role="img" aria-label={alt}>
          Photo: {file}
        </span>
      </>
    )
  }
</div>
