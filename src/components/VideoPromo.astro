---
import site from '../data/site.json';
import Icon from './Icon.astro';
---

<section class="section section--dark" id="video">
  <div class="container promo">
    <div class="section-head">
      <span class="badge">See us at work</span>
      <h2>One call for <span class="hl">plumbing, heating & fire protection</span></h2>
    </div>

    <div class="promo__player">
      <!-- Plays muted when scrolled into view; viewers can unmute with the controls -->
      <video
        class="promo__video"
        src="/video/gig-promo-16x9.mp4"
        poster="/video/gig-promo-16x9-poster.jpg"
        width="1280"
        height="720"
        muted
        loop
        playsinline
        controls
        preload="none"
        aria-label="GIG Technology video: plumbing, heating and fire protection services"
      ></video>
    </div>

    <div class="btn-row promo__cta">
      <a href="#quote" class="btn btn--accent">
        Get a Free Quote <span class="btn__arrow"><Icon name="arrow" size={18} /></span>
      </a>
      <a href={site.phone.href} class="btn btn--outline">
        <Icon name="phone" size={18} /> Call {site.phone.display}
      </a>
    </div>
  </div>
</section>

<style>
  .promo .section-head {
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .promo__player {
    max-width: 1100px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    background: var(--navy-950);
    aspect-ratio: 16 / 9;
  }
  .promo__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .promo__cta {
    justify-content: center;
    margin-top: clamp(24px, 4vw, 40px);
  }
  .promo__cta .btn--outline {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.5);
  }
  @media (max-width: 600px) {
    .promo__player {
      border-radius: var(--radius);
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('.promo__video');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (video && !reduced && 'IntersectionObserver' in window) {
    let userPaused = false;
    video.addEventListener('pause', () => {
      if (video.dataset.auto !== '1') userPaused = true;
      video.dataset.auto = '';
    });
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          if (!userPaused) video.play().catch(() => {});
        } else if (!video.paused) {
          video.dataset.auto = '1';
          video.pause();
        }
      },
      { threshold: 0.5 }
    ).observe(video);
  }
</script>
