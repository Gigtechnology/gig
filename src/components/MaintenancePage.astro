---
// Neutral "temporarily unavailable" page shown on every URL while site.json "maintenance" is true.
// Deliberately shows no business name, logo or contact details.
---

<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Temporarily unavailable</title>
    <link rel="icon" href="data:," />
    <style>
      html,
      body {
        height: 100%;
        margin: 0;
      }
      body {
        display: grid;
        place-items: center;
        padding: 24px;
        box-sizing: border-box;
        background: #f6f8fb;
        color: #1a2233;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        text-align: center;
      }
      h1 {
        margin: 0 0 8px;
        font-size: clamp(1.4rem, 4vw, 2rem);
      }
      p {
        margin: 0;
        color: #4a5568;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>This website is temporarily unavailable</h1>
      <p>Please check back soon.</p>
    </main>
  </body>
</html>
