---
import site from '../data/site.json';
import Icon from './Icon.astro';

interface Props {
  badge: string;
  highlight?: string;
  title: string;
  titleEnd?: string;
  /** put the highlight before the title (home) or between title and titleEnd (services) */
  highlightFirst?: boolean;
  subtitle: string;
  image?: string | null;
  imageFile: string;
  quoteHref?: string;
  compact?: boolean;
  /** desktop: photo on the right 64%, text on a solid left panel */
  photoSide?: boolean;
  /** 16:9 video shown in full beside the text (replaces the background photo) */
  video?: string;
  videoPoster?: string;
}
const { badge, highlight, title, titleEnd, highlightFirst = false, subtitle, image: imageProp, imageFile, quoteHref = '#quote', compact = false, photoSide = false, video, videoPoster } = Astro.props;
const image = video ? null : imageProp;
---

<section class:list={['hero on-dark', { 'hero--compact': compact, 'hero--photo': !!image, 'hero--side': !!image && photoSide, 'hero--video': !!video }]}>
  {
    image && (
      <img
        class="hero__bg"
        src={image}
        srcset={/\.jpe?g$/i.test(image) && image.startsWith('/images/') ? `${image.replace(/\.jpe?g$/i, '-800.jpg')} 800w, ${image} 1920w` : undefined}
        sizes="100vw"
        alt=""
        fetchpriority="high"
      />
    )
  }
  <!-- TODO : à confirmer avec le client — hero photo (see IMAGES-A-FOURNIR.md) -->
  <div class="container hero__inner">
    <span class="badge">{badge}</span>
    <h1>
      {highlightFirst ? (
        <Fragment><span class="hl">{highlight}</span>{` ${title}`}</Fragment>
      ) : (
        <Fragment>{title}{highlight && <Fragment>{' '}<span class="hl">{highlight}</span></Fragment>}{titleEnd && ` ${titleEnd}`}</Fragment>
      )}
    </h1>
    <p class="hero__sub">{subtitle}</p>
    <div class="btn-row">
      <a href={quoteHref} class="btn btn--accent">
        Get a Free Quote <span class="btn__arrow"><Icon name="arrow" size={18} /></span>
      </a>
      <a href={site.phone.href} class="btn btn--outline">
        <Icon name="phone" size={18} /> Call {site.phone.display}
      </a>
    </div>
    <slot />
    {
      video && (
        <div class="hero__media">
          <video
            class="hero__video"
            src={video}
            poster={videoPoster}
            width="1280"
            height="720"
            autoplay
            muted
            loop
            playsinline
            controls
            preload="metadata"
            aria-label="GIG Technology video: plumbing, heating and fire protection services"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    color: #c9d6ff;
    padding-block: clamp(72px, 10vw, 150px);
    background:
      radial-gradient(ellipse 60% 80% at 85% 20%, rgba(47, 123, 255, 0.35), transparent 60%),
      radial-gradient(ellipse 50% 60% at 10% 100%, rgba(23, 71, 201, 0.4), transparent 60%),
      linear-gradient(135deg, var(--navy-950) 0%, var(--navy-900) 55%, var(--navy-800) 100%);
  }
  /* subtle pipe-grid pattern from the palette (stands in until a photo is provided) */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 2px, transparent 2px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 2px, transparent 2px);
    background-size: 64px 64px;
    mask-image: linear-gradient(90deg, transparent 0%, #000 60%);
  }
  .hero--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(7, 22, 64, 0.92) 0%, rgba(7, 22, 64, 0.7) 55%, rgba(7, 22, 64, 0.35) 100%);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Photo kept on the right on desktop so the subject is not hidden behind the text */
  @media (min-width: 1101px) {
    .hero--side .hero__bg {
      left: auto;
      width: 64%;
      object-position: 50% 30%;
    }
    /* Compact heroes are short: keep the technician's face in the visible band */
    .hero--side.hero--compact .hero__bg {
      object-position: 50% 12%;
    }
    .hero--side::after {
      background: linear-gradient(
        90deg,
        var(--navy-950) 0%,
        var(--navy-950) 36%,
        rgba(7, 22, 64, 0.55) 50%,
        rgba(7, 22, 64, 0.05) 75%,
        rgba(7, 22, 64, 0) 100%
      );
    }
    .hero--side .hero__inner > * {
      max-width: 640px;
    }
  }
  /* Phones & tablets: photo shown as a clear band on top, text below on navy */
  @media (max-width: 1100px) {
    .hero--side,
    .hero--side.hero--compact {
      --band: min(66vw, 520px);
      padding-top: calc(var(--band) - 24px);
    }
    .hero--side .hero__bg {
      height: var(--band);
      bottom: auto;
      object-position: 58% 30%;
    }
    .hero--side::after {
      background: linear-gradient(
        180deg,
        rgba(7, 22, 64, 0) 0%,
        rgba(7, 22, 64, 0) calc(var(--band) * 0.55),
        var(--navy-950) var(--band)
      );
    }
  }
  /* Video hero: text + form on the left, the 16:9 video in full on the right */
  .hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--navy-950);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.4);
  }
  .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 1101px) {
    .hero--video .hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      column-gap: clamp(32px, 4vw, 64px);
      align-items: start;
    }
    .hero--video h1 {
      font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    }
    .hero--video .hero__inner > * {
      grid-column: 1;
      max-width: 620px;
    }
    .hero--video .hero__inner > .hero__media {
      grid-column: 2;
      grid-row: 1 / span 5;
      align-self: start;
      margin-top: 8px;
      max-width: none;
    }
  }
  @media (max-width: 1100px) {
    .hero--video {
      padding-top: 32px;
    }
    .hero--video .hero__inner {
      display: flex;
      flex-direction: column;
    }
    .hero--video .hero__media {
      order: -1;
      width: 100%;
      max-width: none;
      margin-bottom: 32px;
      border-radius: var(--radius);
    }
  }
  .hero--compact {
    padding-block: clamp(56px, 7vw, 104px);
  }
  .hero__inner > * {
    max-width: 780px;
  }
  .hero h1 {
    color: var(--white);
    margin-bottom: 22px;
  }
  .hero--compact h1 {
    font-size: clamp(2rem, 3.8vw, 3.1rem);
  }
  .hero__sub {
    font-size: clamp(1.02rem, 1.3vw, 1.18rem);
    max-width: 640px;
    margin-bottom: 36px;
  }
</style>
